# Copy to .env (next to compose.yaml) and adjust; .env is ignored by git.
# Your user and group id, so that files the containers write belong to you (run `id`).
FINMESH_UID=1000
FINMESH_GID=1000
# The checkout mounted at /app. For the sealed-test stages, a clone checked out at the
# signed commit (docs/containers.md, step 3), e.g. ../FinMesh-primary or ../FinMesh-a25.
FINMESH_SRC=.
# The data folder mounted at /data (raw AMLworld files, Parquet, artifacts). Use an
# absolute path when FINMESH_SRC points to another clone, so every clone shares it.
FINMESH_DATA_DIR=./data
# Optional: Kaggle API token for `finmesh download`.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: narrative models (defaults shown).
MODEL=llama3.2:3b
A25_MODEL=qwen3:8b
